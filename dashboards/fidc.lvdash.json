{
  "datasets": [
    {
      "name": "valuation_long",
      "displayName": "Valuation by day",
      "queryLines": [
        "select as_of_date, fund_code, 'Present value (VP)' as measure, present_value as amount from rpt_fund_daily_summary\n",
        "union all\n",
        "select as_of_date, fund_code, 'Loss provision (PDD)', provision_amount from rpt_fund_daily_summary\n",
        "union all\n",
        "select as_of_date, fund_code, 'Net asset value (VPL)', net_portfolio_value from rpt_fund_daily_summary\n"
      ]
    },
    {
      "name": "latest_by_fund",
      "displayName": "Latest day",
      "queryLines": [
        "select * from rpt_fund_daily_summary\n",
        "where as_of_date = (select max(as_of_date) from rpt_fund_daily_summary)\n"
      ]
    },
    {
      "name": "payments_total",
      "displayName": "Payments received to date",
      "queryLines": [
        "select fund_code, sum(cash_flow) as payments_received\n",
        "from fct_installment_events where event_type in ('FULL', 'PARTIAL')\n",
        "group by fund_code\n"
      ]
    },
    {
      "name": "payments_by_day",
      "displayName": "Payments by day",
      "queryLines": [
        "select event_date, fund_code, event_type, sum(cash_flow) as amount_received\n",
        "from fct_installment_events where event_type in ('FULL', 'PARTIAL')\n",
        "group by event_date, fund_code, event_type\n"
      ]
    },
    {
      "name": "aging_bands",
      "displayName": "Aging bands (latest day)",
      "queryLines": [
        "select fund_code,\n",
        "       case when days_overdue <= 0 then '0. Current'\n",
        "            when days_overdue <= 30 then '1. 1-30 days'\n",
        "            when days_overdue <= 60 then '2. 31-60 days'\n",
        "            when days_overdue <= 90 then '3. 61-90 days'\n",
        "            else '4. Over 90 days' end as aging_band,\n",
        "       sum(outstanding_amount) as outstanding_amount, count(*) as receivables\n",
        "from fct_daily_portfolio where as_of_date = (select max(as_of_date) from fct_daily_portfolio)\n",
        "group by 1, 2\n"
      ]
    },
    {
      "name": "provision_by_bucket",
      "displayName": "Provision by bucket (latest day)",
      "queryLines": [
        "select fund_code, provision_bucket, sum(provision_amount) as provision_amount,\n",
        "       count(*) as receivables\n",
        "from fct_daily_portfolio where as_of_date = (select max(as_of_date) from fct_daily_portfolio)\n",
        "group by fund_code, provision_bucket\n"
      ]
    },
    {
      "name": "maturity",
      "displayName": "Receivables by due month (latest day)",
      "queryLines": [
        "select fund_code, date_trunc('month', due_date) as due_month,\n",
        "       sum(outstanding_amount) as outstanding_amount, count(*) as receivables\n",
        "from fct_daily_portfolio where as_of_date = (select max(as_of_date) from fct_daily_portfolio)\n",
        "group by fund_code, date_trunc('month', due_date)\n"
      ]
    },
    {
      "name": "rejections",
      "displayName": "Rejections by file",
      "queryLines": [
        "select file_date, fund_code, event_type, file_name, row_count, rejected_count,\n",
        "       rejection_rate, rejection_reasons\n",
        "from rpt_ingestion_quality where is_latest_version\n"
      ]
    },
    {
      "name": "rejections_by_day",
      "displayName": "Rejections by day",
      "queryLines": [
        "select file_date, fund_code, sum(rejected_count) as rejected_rows, sum(row_count) as total_rows\n",
        "from rpt_ingestion_quality where is_latest_version\n",
        "group by file_date, fund_code\n"
      ]
    }
  ],
